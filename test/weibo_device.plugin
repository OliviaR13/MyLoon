#!name = 微博纯 IP 属地分流
#!desc = 仅代理 api.weibo.cn(实测确认的归属地判定域名)，并修改来源列表和发博请求里的机型标识（默认 iPhone 18 Pro Max）。
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weibo.png
#!date = 2026-09-30
#!version = 2.2.0

[Rule]
DOMAIN, api.weibo.cn,PROXY

[Script]
http-request ^https?:\/\/api\.weibo\.cn\/2\/device\/ script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/weibo_device.js, requires-body=true, timeout=10, tag=微博机型伪装-来源列表
http-request ^https?:\/\/api\.weibo\.cn\/2\/statuses\/(send|update|repost) script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/weibo_device.js, requires-body=true, timeout=10, tag=微博机型伪装-发博

[MITM]
hostname = api.weibo.cn
