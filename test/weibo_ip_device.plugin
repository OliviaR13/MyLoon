#!name = 微博纯 IP 属地分流 test
#!desc = 仅代理 api.weibo.cn(实测确认的归属地判定域名)，并可在插件设置里选择伪装的机型。
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weibo.png
#!date = 2026-09-30
#!version = 2.3.0

[Argument]
MODEL = select,"iPhone 18 Pro Max","iPhone 18 Pro Max 美版","iPhone 18 Pro","iPhone 17 Pro Max","iPhone 17 Pro","iPhone 17","iPhone Air","iPhone 16 Pro Max","iPhone 16 Pro","iPhone 16 Plus","iPhone 16","iPhone 16e","iPhone 15 Pro Max","iPhone 15 Pro","iPhone 15 Plus","iPhone 15","iPhone 14 Pro Max","iPhone 14 Pro","iPhone 14 Plus","iPhone 14","iPhone 13 Pro Max","iPhone 13 Pro","iPhone 13","iPhone 13 mini","iPhone 12 Pro Max","iPhone 12 Pro","iPhone 12","iPhone 12 mini","iPhone 11 Pro Max","iPhone 11 Pro","iPhone 11",tag=伪装机型,desc=选择后需在微博的微博来源里重新选一次
DEBUG = switch,true,tag=输出日志,desc=开启后在 Loon 日志里显示脚本的修改结果

[Rule]
DOMAIN, api.weibo.cn,PROXY

[Script]
http-request ^https?:\/\/api\.weibo\.cn\/2\/device\/ script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/test/weibo%20device.js, requires-body=true, timeout=10, tag=微博机型伪装-来源列表, argument=[{MODEL},{DEBUG}]
http-request ^https?:\/\/api\.weibo\.cn\/2\/statuses\/(send|update|repost) script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/test/weibo%20device.js, requires-body=true, timeout=10, tag=微博机型伪装-发博, argument=[{MODEL},{DEBUG}]

[MITM]
hostname = api.weibo.cn
