#!name = 抖音微博纯 IP 属地分流
#!desc = 只代理抖音、微博两款 App 中真正承载 IP 属地判定信号的接口，其余 Feed 流、图片、视频等媒体 CDN 一律直连，不占用代理流量，也不影响加载速度与账号安全。微博自建 HTTPDNS（dns.weibo.cn）改走直连，经两次独立抓包验证有效。抓包同时发现两类与本插件规则无关的热启动异常，已记录在规则注释中，供后续排查参考：一是 sinaimg.cn 个别边缘节点偶发直连被远端重置（仅一次抓包出现，此后未复现，暂不额外加规则）；二是微博自带的部分预加载接口（如视频播放信息批量获取）设有 3 秒客户端超时，热启动瞬间首次建立到代理节点的连接如果超过这个时间就会被 App 自己取消，这是延迟问题，不是路由问题，换更低延迟的代理节点或接受这类接口偶发失败是唯二现实的应对方式。规则范围严格限定于这两款 App 的核心域名，不含任何海外服务规则，不影响其他境外 App。安装后请在插件配置页手动指定一个固定的单一亚洲节点作为代理策略，不要用自动测速/自动切换的策略组，否则节点切换会打断微博的长连接。⚠️ 请将本插件放在 GEOIP,cn,DIRECT 等国内直连规则之前，并确认它排在其他同类参考规则集（如 anti-ip-attribution）之前加载，避免被后者未做直连例外的同名规则抢先命中。若同时使用了微博去广告类插件，注意它可能会对 api.weibo.cn/api.weibo.com 做 MITM 解密和响应体脚本改写，属于独立的另一层机制，出现异常时建议分别排查。

#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weibo.png
#!date = 2026-09-23
#!version = 1.9.3

[Rule]
# === 1. 抖音媒体/业务 CDN —— 直连 ===
# 均为内容分发域名，社区多次验证与属地判定无关
DOMAIN-SUFFIX, douyinvod.com, DIRECT
DOMAIN-SUFFIX, douyinpic.com, DIRECT
DOMAIN-SUFFIX, byteimg.com, DIRECT
DOMAIN-SUFFIX, zijieapi.com, DIRECT
DOMAIN-SUFFIX, ecombdapi.com, DIRECT
DOMAIN-SUFFIX, pstatp.com, DIRECT
DOMAIN, aweme.snssdk.com, DIRECT

# === 2. 抖音属地/风控信号 —— 代理 ===
# amemv.com 整域代理，兜底 logbk 等未被下方关键字覆盖的上报接口
DOMAIN-SUFFIX, amemv.com, PROXY
DOMAIN-KEYWORD, core-c-lq, PROXY
DOMAIN-KEYWORD, core-lq, PROXY
DOMAIN-KEYWORD, normal-c-lq, PROXY
DOMAIN-KEYWORD, normal-lq, PROXY
DOMAIN-KEYWORD, search-quic-lq, PROXY
DOMAIN-KEYWORD, search-lq, PROXY
DOMAIN-KEYWORD, -normal-hl, PROXY
DOMAIN-KEYWORD, -normal-c-hl, PROXY
DOMAIN-KEYWORD, -core-c-hl, PROXY
DOMAIN-KEYWORD, -normal-lf, PROXY
DOMAIN-KEYWORD, -normal-c-lf, PROXY
DOMAIN-KEYWORD, -core-c-lf, PROXY
DOMAIN, sso.douyin.com, PROXY
DOMAIN, www.douyin.com, PROXY
DOMAIN-SUFFIX, snssdk.com, PROXY

# === 3. 微博媒体 CDN 与 HTTPDNS —— 直连 ===
# dns.weibo.cn 是微博自建 HTTPDNS，主要用于解析 sinaimg.cn 图片 CDN。
# 它必须和它解析的 CDN 域名走同一条网络路径，否则 App 拿到的是"代理视角
# 下的最优 IP"、却用真实网络去连，路径不一致；此规则已通过两次独立抓包
# 验证有效（第二次抓包 dns.weibo.cn 全部正确命中 DIRECT，解析结果与实
# 际连接路径一致），不占用任何代理流量。
DOMAIN-SUFFIX, weibocdn.com, DIRECT
DOMAIN-SUFFIX, sinajs.cn, DIRECT
DOMAIN-SUFFIX, wbimg.cn, DIRECT
DOMAIN-SUFFIX, wbimg.com, DIRECT
DOMAIN, dns.weibo.cn, DIRECT
DOMAIN-SUFFIX, sinaimg.cn, DIRECT
# 观察记录（非规则）：早期一次抓包里 163.181.39.0/24 网段的个别边缘节点
# （具体表现为 wx1.sinaimg.cn 解析到 163.181.39.185）出现过 TCP 握手成功
# 后被远端直接 RST 的情况，怀疑是该网段到直连出口的连通性问题。但此后
# 的抓包（wx1 这次解析到完全不同的 IP）未再复现，且该网段是否稳定有问
# 题证据不足；同时给单一网段或子域名加 PROXY 例外都存在误伤其他流量或
# 覆盖不全的副作用，权衡后暂不加规则。如果后续再次抓到同类失败，记录
# 一下当时命中的具体 IP/子域名再决定要不要加例外，不要凭一次抓包定死。

# === 4. 微博属地判定与业务 API —— 代理 ===
# api.weibo.cn 的 /2/carrier/get/info 接口会直接回显服务器看到的客户端 IP，
# 是真正的属地判定信号来源（抓包已验证响应体为 {"ip":"代理节点出口IP"}），
# 同时承载了 Feed、未读数、IM、推送、预加载等绝大部分业务请求。纯 JSON
# 小流量，走代理不会明显增加流量消耗或卡顿。
DOMAIN-SUFFIX, weibo.cn, PROXY
DOMAIN-SUFFIX, weibo.com, PROXY
DOMAIN-KEYWORD, weibo, PROXY
# 已知与本插件规则无关的热启动异常（记录备查，不是靠规则修的）：
# 微博部分接口（如 /2/!/multimedia/playback/batch_get 视频信息预加载）
# 在请求里自带 WBNetwork.Request.TimeOut.Interval=3，即 App 自己给这类
# 接口设了 3 秒客户端超时。热启动瞬间第一批请求还没有到代理节点的现成
# 连接，需要冷建立一条新隧道，如果这个过程耗时接近或超过 3 秒，App 会
# 在收到响应前自己把请求取消掉（表现为该接口失败，其余请求不受影响）。
# 这是"代理节点冷启动延迟 vs App 超时"的竞速问题，路由/规则层面无法
# 解决；如果频繁出现，可尝试的方向是换一个延迟更低、离得更近的代理节
# 点，而不是继续在这个文件里加规则。
