#!name = 抖音微博纯 IP 属地分流
#!desc = 仅将抖音与微博涉及 IP 属地的核心接口送入代理，正文 Feed 流、视频、图片等媒体 CDN 全部直连。不包含任何海外服务规则，绝对不影响其他外网 App。
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://github.com/OliviaR13/MyLoon/icons/ip.png
#!date = 2026-08-12

[Rule]
# === 1. 抖音/微博 媒体流及 Feed 正文 (强制直连) ===
# 抖音：视频、图片 CDN 及 Feed 推荐正文流
DOMAIN-SUFFIX, douyinvod.com, DIRECT
DOMAIN-SUFFIX, douyinpic.com, DIRECT
DOMAIN-SUFFIX, douyincdn.com, DIRECT
DOMAIN-SUFFIX, byteoversea.com, DIRECT
DOMAIN-SUFFIX, ibyteimg.com, DIRECT
DOMAIN-SUFFIX, pstatp.com, DIRECT
DOMAIN-KEYWORD, douyin-video, DIRECT
DOMAIN, aweme.snssdk.com, DIRECT
DOMAIN-SUFFIX, bytev.com, DIRECT

# 微博：图床、视频 CDN 及 Feed 正文刷新流
DOMAIN-SUFFIX, sinaimg.cn, DIRECT
DOMAIN-SUFFIX, sinajs.cn, DIRECT
DOMAIN-SUFFIX, weibocdn.com, DIRECT
DOMAIN-SUFFIX, video.weibo.com, DIRECT
DOMAIN, unread.api.weibo.cn, DIRECT
DOMAIN, status.api.weibo.cn, DIRECT

# === 2. 抖音/微博 纯 IP 属地 & 核心 API (走指定节点/策略组) ===
# 抖音 IP 属地/评论 API
DOMAIN-SUFFIX, amemv.com, 台湾手动策略
DOMAIN-SUFFIX, douyin.com, 台湾手动策略
DOMAIN-SUFFIX, snssdk.com, 台湾手动策略

# 微博 IP 属地/评论 API
DOMAIN, api.weibo.cn, 台湾手动策略
DOMAIN-SUFFIX, passport.weibo.cn, 台湾手动策略

