#!name = 抖音微博纯 IP 属地分流
#!desc = 仅将抖音与微博涉及 IP 属地的核心接口送入代理，正文 Feed 流、视频、图片及网页服务（如举报页面）全部直连。安装插件后，请在插件配置页选择用于代理的策略/节点。
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://cdn.jsdelivr.net/gh/OliviaR13/MyLoon@main/icons/ip.png
#!date = 2026-08-16

[Rule]
# === 1. 抖音/微博 媒体流、Feed 正文及 Web 服务 (强制直连) ===
# 抖音：视频、图片 CDN 及 Feed 推荐正文流
DOMAIN-SUFFIX, douyinvod.com, DIRECT
DOMAIN-SUFFIX, douyinpic.com, DIRECT
DOMAIN-SUFFIX, douyincdn.com, DIRECT
DOMAIN-SUFFIX, byteoversea.com, DIRECT
DOMAIN-SUFFIX, ibyteimg.com, DIRECT
DOMAIN-SUFFIX, pstatp.com, DIRECT
DOMAIN-KEYWORD, douyin-video, DIRECT
DOMAIN, aweme.snssdk.com, DIRECT
DOMAIN-SUFFIX, bytev.com, DIRECT

# 微博：图床、视频 CDN、Feed 正文刷新流及账号/服务中心网页（修复举报页面）
DOMAIN-SUFFIX, sinaimg.cn, DIRECT
DOMAIN-SUFFIX, sinajs.cn, DIRECT
DOMAIN-SUFFIX, weibocdn.com, DIRECT
DOMAIN-SUFFIX, video.weibo.com, DIRECT
DOMAIN, unread.api.weibo.cn, DIRECT
DOMAIN, status.api.weibo.cn, DIRECT
DOMAIN-SUFFIX, service.account.weibo.com, DIRECT
DOMAIN-SUFFIX, weibo.com, DIRECT

# === 2. 抖音/微博 纯 IP 属地 & 核心 API (走插件安装时用户选择的策略/节点) ===
# 抖音 IP 属地/评论 API
DOMAIN-SUFFIX, amemv.com, PROXY
DOMAIN-SUFFIX, douyin.com, PROXY
DOMAIN-SUFFIX, snssdk.com, PROXY

# 微博 IP 属地/评论 API
DOMAIN, api.weibo.cn, PROXY
DOMAIN-SUFFIX, passport.weibo.cn, PROXY
