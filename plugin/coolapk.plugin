#!name = 酷安 来源机型
#!desc = 自定义发布动态时显示的来源机型，插件设置中可选 iPhone 11 至 iPhone 18 Pro Max 等共 32 款。通过改写请求头 User-Agent 中的机型字段实现，需在 MITM 中启用 api.coolapk.com。
#!tag = 功能增强
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/CoolApk.png
#!date = 2026-10-04
#!version = 1.0.0

[Argument]
ENABLE = switch,true,tag=启用来源机型,desc=开启后改写发布动态时的来源机型，关闭后使用真实机型
MODEL = select,"iPhone 18 Pro Max","iPhone 18 Pro","iPhone Duo","iPhone 17 Pro Max","iPhone 17 Pro","iPhone 17","iPhone Air","iPhone 17e","iPhone 16 Pro Max","iPhone 16 Pro","iPhone 16 Plus","iPhone 16","iPhone 16e","iPhone 15 Pro Max","iPhone 15 Pro","iPhone 15 Plus","iPhone 15","iPhone 14 Pro Max","iPhone 14 Pro","iPhone 14 Plus","iPhone 14","iPhone 13 Pro Max","iPhone 13 Pro","iPhone 13","iPhone 13 mini","iPhone 12 Pro Max","iPhone 12 Pro","iPhone 12","iPhone 12 mini","iPhone 11 Pro Max","iPhone 11 Pro","iPhone 11",tag=来源机型,desc=选择发布动态时显示的机型
DEBUG = switch,false,tag=调试日志,desc=在 Loon 日志中显示脚本的改写结果，用于排查问题

[Script]
http-request ^https?:\/\/api\.coolapk\.com\/v6\/feed\/createFeed script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/coolapk_device.js, timeout=10, tag=酷安来源机型-发动态, argument=[{ENABLE},{MODEL},{DEBUG}]

[MITM]
hostname = api.coolapk.com
