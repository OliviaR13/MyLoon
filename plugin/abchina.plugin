#!name = 中国农业银行 服务异常修复
#!desc = 修复中国农业银行 App 提示"服务异常"的问题。将 App 网关（mobilepaas）、消息推送（firefly）、静态资源 CDN（cdn-static）三类核心域名加入 MITM 跳过列表并强制直连，避免 Loon 证书嗅探改动请求/响应内容触发风控误判。经实测抓包确认域名有效，如仍报错请检查对应请求的 Status Code 和 Response Body 是否为服务端业务报错。

#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/OliviaR13/MyLoon/main/icons/fix.png
#!date = 2026-08-26

[Rule]
# 网关/日志上报（mgw.htm、logUpload.do 等核心接口）
DOMAIN, mobilepaas.abchina.com.cn, DIRECT
# 消息推送/长连接
DOMAIN, firefly.abchina.com.cn, DIRECT
# 静态资源 CDN
DOMAIN, mb.cdn-static.abchina.com.cn, DIRECT
# 兜底：主域及其余子域
DOMAIN-SUFFIX, abchina.com.cn, DIRECT
DOMAIN-SUFFIX, abchina.com, DIRECT

[MITM]
Hostname = %APPEND% mobilepaas.abchina.com.cn, firefly.abchina.com.cn, mb.cdn-static.abchina.com.cn, *.abchina.com.cn
