#!name = Siri ChatGPT 分流
#!desc = 为 Siri 的 ChatGPT 扩展做网络分流：Siri 核心域名（guzzoni.apple.com、siri.apple.com）强制直连并使用真实 IP 解析，避免被 Fake-IP 影响；Apple 资格校验（gspe1-ssl.ls.apple.com、apple-relay）与 OpenAI / ChatGPT 域名统一走 PROXY 策略。安装后请在插件详情页的「代理指向的策略」中选择美国节点或美国策略组，未选择时默认使用全局策略的第一个节点；节点需为稳定的美区出口，不要使用香港或大陆出口，也不要频繁切换。请将本插件放在配置文件中 GEOIP,CN,DIRECT 等国内直连规则之前，并关闭 iRingo / NSRingo 等会劫持 Siri 请求的 MITM 插件。导入后请重启 Loon 并手动重启手机。
#!tag = 代理分流
#!author = OliviaR13
#!version = 1.0.0
#!date = 2026-11-10
#!homepage = https://www.github.com/OliviaR13
#!icon = https://www.google.com/s2/favicons?sz=128&domain=chatgpt.com

[Rule]
# Apple Intelligence / Siri 后端
DOMAIN,guzzoni.apple.com,PROXY
DOMAIN-SUFFIX,smoot.apple.com,PROXY
DOMAIN-KEYWORD,siri,PROXY

# Apple 定位与服务网关
DOMAIN-SUFFIX,ls.apple.com,PROXY
DOMAIN,gateway.icloud.com,PROXY
DOMAIN,apps.mzstatic.com,PROXY

# OpenAI 登录与服务
DOMAIN-SUFFIX,openai.com,PROXY
DOMAIN-SUFFIX,chatgpt.com,PROXY
DOMAIN-SUFFIX,oaistatic.com,PROXY
DOMAIN-SUFFIX,oaiusercontent.com,PROXY

# 验证服务
DOMAIN-SUFFIX,arkoselabs.com,PROXY
DOMAIN-SUFFIX,auth0.com,PROXY

