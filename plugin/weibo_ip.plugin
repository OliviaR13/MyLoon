#!name = 微博纯 IP 属地分流_beta2
#!desc = 仅代理 api.weibo.cn(实测确认的归属地判定域名),CDN/HTTPDNS/广告SDK子域名均直连。详见 README。
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weibo.png
#!date = 2026-09-27
#!version = 2.1.0

[Rule]
# 媒体 CDN / 自建 HTTPDNS,直连
DOMAIN-SUFFIX, weibocdn.com, DIRECT
DOMAIN-SUFFIX, sinajs.cn, DIRECT
DOMAIN-SUFFIX, wbimg.cn, DIRECT
DOMAIN-SUFFIX, wbimg.com, DIRECT
DOMAIN, dns.weibo.cn, DIRECT
DOMAIN-SUFFIX, sinaimg.cn, DIRECT

# 广告 / SDK / 预加载,与归属地判定无关,直连
DOMAIN, ai.s.weibo.com, DIRECT
DOMAIN, bootpreload.uve.weibo.com, DIRECT
DOMAIN, brandvideo.biz.weibo.com, DIRECT
DOMAIN, sdkapp.uve.weibo.com, DIRECT
DOMAIN, wbapp.uve.weibo.com, DIRECT

# 发帖、Feed、资料、详情等业务 API,归属地判定实际发生在这个域名下,代理
DOMAIN, api.weibo.cn, PROXY
