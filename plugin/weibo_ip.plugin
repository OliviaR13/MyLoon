#!name = 微博纯 IP 属地劫持 (正文/视频/图片全直连)
#!desc = 仅将微博评论、发博及 IP 属地更新相关的核心 API 走节点，正文 Feed 流、图片、视频全走直连。
#!author = AI Collaborator
#!homepage = https://github.com
#!icon = https://raw.githubusercontent.com/kwon/Loon-Plugins/main/Icons/weibo.png
#!date = 2026-08-11

[Rule]
# === 1. 媒体流与正文 Feed 流 (强制直连) ===
# 图片 / 图床
DOMAIN-SUFFIX, sinaimg.cn, DIRECT
DOMAIN-SUFFIX, sinajs.cn, DIRECT

# 视频与 CDN
DOMAIN-SUFFIX, weibocdn.com, DIRECT
DOMAIN-SUFFIX, video.weibo.com, DIRECT

# 首页 Feed 正文流/未读数刷新（防止影响正文加载）
DOMAIN, unread.api.weibo.cn, DIRECT
DOMAIN, status.api.weibo.cn, DIRECT

# === 2. IP 属地 & 评论相关核心 API (走指定节点/策略组) ===
# 请将 "台湾手动策略" 替换为你实际使用的策略组或节点名称
DOMAIN, api.weibo.cn, 台湾手动策略
DOMAIN-SUFFIX, passport.weibo.cn, 台湾手动策略
