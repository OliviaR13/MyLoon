#!name = 微博超话签到
#!desc = 每天定时给微博超话签到，并推送汇总。打开微博 App 即自动获取登录状态；进入过的超话会自动记录。状态页（Loon 开启时在 Safari 打开）：http://weibo-checkin.loon/ ，可看登录状态、签到结果，也能一键立即签到。
#!tag = 签到,微博
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weibo.png
#!date = 2026-10-26
#!version = 2.0.0

[Argument]
CRON = input,"10 8 * * *",tag=签到时间,desc=Cron 表达式，默认每天 08:10（分 时 日 月 周）
NOTIFY = switch,true,tag=通知,desc=获取登录状态、签到完成时推送；点击通知可打开状态页
DEBUG = switch,false,tag=调试日志,desc=在 Loon 日志中显示执行过程（不会输出任何登录信息）

[Script]
http-request ^https?:\/\/api\.weibo\.cn\/2\/(remind\/(unread_count|hometab_dot)|client\/tabbar|groups\/allgroups\/v2|page\/button|shproxy\/chaohua\/) script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/weibo_checkin.js, requires-body=false, timeout=10, tag=微博超话-保存登录状态, argument=[{NOTIFY},{DEBUG}]
http-request ^https?:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline_topicpage script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/weibo_checkin.js, requires-body=true, timeout=10, tag=微博超话-记录超话, argument=[{NOTIFY},{DEBUG}]
http-request ^http:\/\/weibo-checkin\.loon\/ script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/weibo_checkin.js, requires-body=false, timeout=300, tag=微博超话-状态页, argument=[{NOTIFY},{DEBUG}]
cron "{CRON}" script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/weibo_checkin.js, timeout=300, tag=微博超话签到, argument=[{NOTIFY},{DEBUG}]
generic script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/weibo_checkin.js, timeout=300, tag=微博超话-立即签到, argument=[{NOTIFY},{DEBUG}]
generic script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/weibo_checkin.js, timeout=10, tag=微博超话-查看状态, argument=[{NOTIFY},{DEBUG}]

[MITM]
hostname = api.weibo.cn
