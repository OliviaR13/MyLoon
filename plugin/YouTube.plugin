#!name = YouTube 自选节点
#!desc = 将 YouTube(网页版、App、视频流 CDN、图片头像、嵌入播放器)相关域名统一走 PROXY 策略,并屏蔽 QUIC 让视频回落 TCP 更稳定。安装后请在插件详情页的「代理指向的策略」中选择用于代理的策略组或节点,未选择时默认使用全局策略的第一个节点。请将本插件放在配置文件中 GEOIP,CN,DIRECT 等国内直连规则之前,否则规则可能被提前匹配而失效。
#!tag = 代理分流
#!author = OliviaR13
#!date = 2026-10-08
#!version = 1.0.0
#!homepage = https://www.github.com/OliviaR13
#!icon = https://www.google.com/s2/favicons?sz=128&domain=youtube.com

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,googlevideo.com)),REJECT
DOMAIN-SUFFIX,youtube.com,PROXY
DOMAIN-SUFFIX,youtu.be,PROXY
DOMAIN-SUFFIX,youtube-nocookie.com,PROXY
DOMAIN-SUFFIX,youtubekids.com,PROXY
DOMAIN-SUFFIX,yt.be,PROXY
DOMAIN-SUFFIX,googlevideo.com,PROXY
DOMAIN-SUFFIX,ytimg.com,PROXY
DOMAIN-SUFFIX,ggpht.com,PROXY
DOMAIN-SUFFIX,withyoutube.com,PROXY
DOMAIN,youtubei.googleapis.com,PROXY
DOMAIN,youtubeembeddedplayer.googleapis.com,PROXY
