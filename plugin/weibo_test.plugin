#!name = （测试）微博纯 IP 属地分流
#!desc = 仅代理 api.weibo.cn/2/carrier/get/info 这一个决定属地显示的接口，且该接口背后挂的是一个"故障转移"策略组（固定节点优先，节点失效自动秒切直连），避免发帖时因为节点卡顿而转圈；同域名下其余业务接口与IM/广告/网页版/媒体CDN全部直连。history: v2.2 用URL-REGEX+MITM把代理范围收窄到仅这一个接口，范围问题解决了，但直接绑定单一固定节点，一旦该节点对这个接口无响应会卡30秒——实测发现每次发帖微博都会调用这个接口做属地校验，节点一卡，发帖动作跟着转圈。v2.3 把这个接口背后的策略换成 fallback 类型（固定节点+直连兜底，健康探测目标就是这个接口本身），节点异常时自动降级直连，不再转圈，代价是节点异常期间那几次属地会短暂显示真实IP，等探测恢复会自动切回代理。
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weibo.png
#!date = 2026-09-26
#!version = 2.3.0

[Rule]
# === 1. 属地判定信号来源 —— 仅此一条走"属地代理"故障转移组 ===
# 每次发帖，微博都会同步调用这个接口做属地校验；如果背后节点无响应，会
# 直接拖累发帖流程转圈。所以这里不再直接绑单一节点，而是绑一个fallback
# 策略组（见下方[Proxy Group]），固定节点优先、节点失效自动切直连。
URL-REGEX, ^https?://api\.weibo\.cn/2/carrier/get/info, 属地代理

# === 2. api.weibo.cn 下其余全部业务接口 —— 直连 ===
DOMAIN, api.weibo.cn, DIRECT

# === 3. 其他 *weibo* 域名（IM/广告/网页版）—— 直连 ===
DOMAIN-SUFFIX, im.weibo.cn, DIRECT
DOMAIN-SUFFIX, weibo.com, DIRECT
DOMAIN-KEYWORD, weibo, DIRECT

# === 4. 媒体 CDN 与自建 HTTPDNS —— 直连 ===
DOMAIN-SUFFIX, weibocdn.com, DIRECT
DOMAIN-SUFFIX, sinajs.cn, DIRECT
DOMAIN-SUFFIX, wbimg.cn, DIRECT
DOMAIN-SUFFIX, wbimg.com, DIRECT
DOMAIN, dns.weibo.cn, DIRECT
DOMAIN-SUFFIX, sinaimg.cn, DIRECT

[Proxy Group]
# "属地代理"优先走"属地节点"（安装本插件后，请在Loon里把"属地节点"手动
# 指定为你自己选好的那个固定单一节点，而不是自动测速组）；health-check
# 直接探测这个接口本身，探测超时3秒就判定节点不可用，自动整体切到DIRECT，
# 不会再让某一次发帖傻等30秒。探测恢复正常后会自动切回代理。
属地代理 = fallback, 属地节点, DIRECT, url = https://api.weibo.cn/2/carrier/get/info, interval = 120, timeout = 3

[MITM]
hostname = api.weibo.cn

# 踩坑记录：
# - "属地节点"这个策略组名Loon安装时会提示你绑定——请绑定到你自己选好的
#   那个固定单一节点（不要绑url-test自动测速组），保证属地稳定不漂移；
# - fallback的健康探测是周期性的（这里120秒一次），不是每次请求都实时探
#   测，所以节点刚好在两次探测之间失效的那一次发帖，仍可能等一次超时；
#   但从下一次探测失败开始，后续请求会立刻走直连，不会反复转圈；
# - 若同时装了微博去广告插件且也声明了对api.weibo.cn的MITM，两者hostname
#   会自动合并，一般不冲突，响应体脚本改写是独立机制，问题请分开排查；
# - 若发现节点频繁被判定失效，大概率是微博对该节点IP做了针对性限流/风控
#   （常见于机房IP），换一个不容易被识别成机房的节点会更稳定。
# 抖音部分自1.9.6起已拆分为独立插件（抖音纯IP属地分流.plugin）。
