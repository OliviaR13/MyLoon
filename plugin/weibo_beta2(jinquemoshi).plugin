#!name = 微博纯 IP 属地分流_beta2(精确模式)
#!desc = 仅 api.weibo.cn/2/carrier/get/info 走代理,该域名下其余路径与 CDN/HTTPDNS 均直连。需要 MITM 解密 api.weibo.cn,有证书锁定导致发帖/登录失败的风险,详见 README。
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weibo.png
#!date = 2026-09-26
#!version = 1.9.7

[Rule]
# 媒体 CDN / 自建 HTTPDNS,直连
DOMAIN-SUFFIX, weibocdn.com, DIRECT
DOMAIN-SUFFIX, sinajs.cn, DIRECT
DOMAIN-SUFFIX, wbimg.cn, DIRECT
DOMAIN-SUFFIX, wbimg.com, DIRECT
DOMAIN, dns.weibo.cn, DIRECT
DOMAIN-SUFFIX, sinaimg.cn, DIRECT

# 属地判定接口,代理;api.weibo.cn 其余路径,直连
URL-REGEX, ^https?:\/\/api\.weibo\.cn\/2\/carrier\/get\/info, PROXY
URL-REGEX, ^https?:\/\/api\.weibo\.cn\/(?!2\/carrier\/get\/info), DIRECT
DOMAIN, api.weibo.cn, PROXY
DOMAIN-SUFFIX, weibo.cn, PROXY
DOMAIN-SUFFIX, weibo.com, PROXY
DOMAIN-KEYWORD, weibo, PROXY

[MITM]
hostname = api.weibo.cn

[Script]
weibo_ip = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/2\/carrier\/get\/info, requires-body=true, max-size=-1, script-path=scripts/weibo_ip.js, timeout=10
