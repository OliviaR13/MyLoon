#!name = ChatGPT 去广告
#!desc = 移除 ChatGPT App 回答下方的赞助广告卡片（需 MitM 解密 chatgpt.com）
#!author = you
#!system = iOS
#!loon_version = 3.5.1(983)
#!tag = 去广告

[Argument]
enabled = switch,true,tag=启用,desc=开关 ChatGPT 去广告脚本

[Script]
response if ${url} ~= /^https:\/\/(?:[\w-]+\.)?chatgpt\.com\/(?!.*\/(?:f\/)?conversation(?:\?|$))/ then script("https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/chatgpt%20noads.js") with enable=${enabled}, requires_body=true, tag="ChatGPT去广告"

[Mitm]
hostname = chatgpt.com, *.chatgpt.com
