#!name = Meta AI Muse 自选节点
#!desc = 将 Meta AI / Muse、Meta 账号登录及相关 CDN 请求统一交给 PROXY 策略，并仅对这些域名拦截 QUIC，避免 UDP/QUIC 绕过代理。PROXY 使用你在 Loon 中为插件映射的策略组；实际出口地区由节点出口 IP 及 Meta 的 IP 地理库决定。本插件不能伪装或修改出口 IP 的地理位置。
#!tag = 代理分流
#!author = OliviaR13
#!version = 1.2.0
#!date = 2026-11-18
#!homepage = https://www.github.com/OliviaR13
#!icon = https://www.google.com/s2/favicons?sz=128&domain=meta.ai

[Rule]
# 仅拦截 Meta 相关域名的 QUIC，促使客户端回落到 TCP；不影响其他应用的 QUIC
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,muse.ai)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,metaaivm.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,meta.ai)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,meta.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,atmeta.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,metaaiusercontent.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,ecto1usercontent.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,hatch.ecto1.ai)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,node.hatch.one)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,customer.prod.willow606.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,meta-agents-apps.workers.dev)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,meta-ohttp-relay-prod.fastly-edge.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,meta-ohttp-relay-dev.fastly-edge.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,meta-ohttp-config-prod.fastly-edge.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,meta.privacy-gateway.cloudflare.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,meta.hpke-keys.privacy-gateway.cloudflare.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,facebook.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,facebook.net)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,fb.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,fb.me)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,fbsbx.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,fbcdn.net)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,instagram.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,cdninstagram.com)),REJECT

# Meta AI / Muse 服务本体
DOMAIN-SUFFIX,meta.ai,PROXY
DOMAIN-SUFFIX,muse.ai,PROXY
DOMAIN-SUFFIX,metaaivm.com,PROXY

# Meta 账号、身份验证与用户内容
DOMAIN-SUFFIX,meta.com,PROXY
DOMAIN-SUFFIX,atmeta.com,PROXY
DOMAIN-SUFFIX,metaaiusercontent.com,PROXY
DOMAIN-SUFFIX,ecto1usercontent.com,PROXY

# Muse Hatch 网关、工作节点
DOMAIN,hatch.ecto1.ai,PROXY
DOMAIN,node.hatch.one,PROXY
DOMAIN-SUFFIX,customer.prod.willow606.com,PROXY
DOMAIN,meta-agents-apps.workers.dev,PROXY

# Muse OHTTP / 隐私中继（只匹配实际使用的主机，不代理整个 Fastly / Cloudflare 父域）
DOMAIN,meta-ohttp-relay-prod.fastly-edge.com,PROXY
DOMAIN,meta-ohttp-relay-dev.fastly-edge.com,PROXY
DOMAIN,meta-ohttp-config-prod.fastly-edge.com,PROXY
DOMAIN,meta.privacy-gateway.cloudflare.com,PROXY
DOMAIN,meta.hpke-keys.privacy-gateway.cloudflare.com,PROXY

# Facebook / Instagram 登录与账号关联
DOMAIN-SUFFIX,facebook.com,PROXY
DOMAIN-SUFFIX,facebook.net,PROXY
DOMAIN-SUFFIX,fb.com,PROXY
DOMAIN-SUFFIX,fb.me,PROXY
DOMAIN-SUFFIX,fbsbx.com,PROXY
DOMAIN-SUFFIX,instagram.com,PROXY

# 图片、视频与静态资源 CDN
DOMAIN-SUFFIX,fbcdn.net,PROXY
DOMAIN-SUFFIX,cdninstagram.com,PROXY
