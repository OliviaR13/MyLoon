#!name = 千问转 Gemini（Siri）
#!desc = 把 Siri 发往千问的文本请求改由 Gemini API 回答，并按千问事件流回给 Siri。填写 Gemini API Key 即可使用。请求默认按你的 Loon 配置规则分流，失败时依次尝试「备用策略」。
#!tag = AI,Siri,功能增强
#!system = iOS
#!loon_version = 3.2.4
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google.png
#!date = 2026-11-07
#!version = 2.0.0

[Argument]
KEY = input,"",tag=Gemini API Key,desc=在 aistudio.google.com/apikey 获取（AIza… 或 AQ.… 开头均可）
MODEL = input,"gemini-2.5-flash",tag=模型,desc=Gemini 模型名，如 gemini-2.5-flash / gemini-2.5-pro
SEARCH = switch,false,tag=联网搜索,desc=开启后使用 Google Search 接地（会更慢）
FAST = switch,true,tag=快速模式,desc=关闭模型思考以加快回复（仅 flash 系列生效）
PROMPT = input,"你是 Siri 的后台助手。请用简洁、口语化的中文回答，适合直接朗读；不要使用 Markdown、列表符号或表情。",tag=系统提示词,desc=控制回答风格
BACKUP = input,"日本时延优选,日本手动策略",tag=备用策略,desc=按配置规则连不上时，依次尝试这些策略/节点（逗号分隔，名字需与策略页一致）；留空则不使用备用
BASE = input,"https://generativelanguage.googleapis.com",tag=API 地址,desc=默认官方地址；使用反代时改这里

[Script]
http-request ^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses requires-body=true, timeout=60, script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/qianwen/qianwen_siri_gemini.js, argument=[{KEY},{MODEL},{SEARCH},{FAST},{PROMPT},{BACKUP},{BASE}], tag=千问转Gemini

[MitM]
hostname = prod-yabuli.qianwen.com
