#!name = Siri to Gemini
#!desc = 将 Siri 请求交由 Google Gemini API 处理，并转换为兼容响应格式。支持文本对话、相机识图、写作工具、联网搜索及自定义模型，网络请求遵循 Loon 当前配置规则，不使用千问作为上游或备用服务。
#!tag = AI,Siri,功能增强
#!system = iOS
#!loon_version = 3.2.4
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google.png
#!date = 2026-11-07
#!version = 2.6.0

[Argument]
KEY = input,"",tag=Gemini API Key,desc=在 aistudio.google.com/apikey 获取，粘贴即可（自动去除空格）
MODEL = select,"gemini-2.5-flash","gemini-3.1-flash-lite","gemini-2.5-flash-lite","gemini-2.5-pro","gemini-flash-latest",tag=模型,desc=flash-lite 最快最省；flash 均衡；pro 最强但较慢
CUSTOM_MODEL = input,"",tag=自定义模型（可选）,desc=填写后优先于上面的选择，如 gemini-3.1-pro-preview；留空则不生效
STYLE = select,"简短口语","标准","详细",tag=回答风格,desc=简短口语最适合 Siri 朗读；详细会更长更慢
PROMPT = input,"",tag=额外提示词（可选）,desc=追加在风格提示之后，例如「称呼我为…」；留空即可
SEARCH = switch,false,tag=联网搜索,desc=使用 Google Search 接地，可查实时信息（会更慢）
FAST = switch,true,tag=快速模式,desc=压低模型思考以加快回复（仅 flash 系列生效）
BASE = input,"https://generativelanguage.googleapis.com",tag=API 地址,desc=默认官方地址；使用反代时改这里（无需带 /v1beta）

[Script]
http-request ^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses requires-body=true, timeout=60, script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/qianwen/qianwen_siri_gemini.js, argument=[{KEY},{MODEL},{CUSTOM_MODEL},{STYLE},{PROMPT},{SEARCH},{FAST},{BASE}], tag=Siri to Gemini

[MitM]
hostname = prod-yabuli.qianwen.com
