#!name = 千问转 Gemini（Siri）
#!desc = 把 Siri 发往千问的文本请求改由 Gemini API 回答，并按千问事件流回给 Siri。安装后在插件参数里填写 Gemini API Key；Gemini 请求会先走「备用策略」里的策略/节点（默认日本），失败再按 Loon 配置规则分流，不受配置里 AI 规则的影响。
#!tag = AI,Siri,功能增强
#!system = iOS
#!loon_version = 3.2.4
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google.png
#!date = 2026-11-07
#!version = 1.4.0

[Argument]
KEY = input,"",tag=Gemini API Key,desc=在 aistudio.google.com/apikey 获取（AIza… 或 AQ.… 开头均可）
MODEL = input,"gemini-2.5-flash",tag=模型,desc=Gemini 模型名，如 gemini-2.5-flash / gemini-2.5-pro
SEARCH = switch,false,tag=联网搜索,desc=开启后使用 Google Search 接地（会更慢）
FAST = switch,true,tag=快速模式,desc=关闭模型思考以加快回复（仅 flash 系列生效）
PROMPT = input,"你是 Siri 的后台助手。请用简洁、口语化的中文回答，适合直接朗读；不要使用 Markdown、列表符号或表情。",tag=系统提示词,desc=控制回答风格
NODES = input,"日本时延优选,日本手动策略,台湾时延优选",tag=备用策略,desc=Gemini 请求先按顺序尝试这些策略/节点（用逗号分隔），都失败再按 Loon 配置规则；用来绕开配置里不通的 AI 规则。留空则只按配置规则
BASE = input,"https://generativelanguage.googleapis.com",tag=API 地址,desc=默认官方地址；使用反代时改这里

[Script]
http-request ^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses requires-body=true, timeout=60, script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/qianwen/qianwen_gemini_v3.js, argument=[{KEY},{MODEL},{SEARCH},{FAST},{PROMPT},{BASE},{NODES}], tag=千问转Gemini

[MitM]
hostname = prod-yabuli.qianwen.com
