#!name = 推特 自选节点
#!desc = 将 Twitter/X（网页版、App、图片视频 CDN、短链服务）相关域名统一走 PROXY 策略。安装后请在插件详情页的「代理指向的策略」中选择用于代理的策略组或节点，未选择时默认使用全局策略的第一个节点。请将本插件放在配置文件中 GEOIP,CN,DIRECT 等国内直连规则之前，否则规则可能被提前匹配而失效。
#!tag = 代理分流
#!author = OliviaR13
#!version = 1.0.0
#!homepage = https://www.github.com/OliviaR13
#!icon = https://www.google.com/s2/favicons?sz=128&domain=x.com

[Rule]
DOMAIN-SUFFIX,twitter.com,PROXY
DOMAIN-SUFFIX,x.com,PROXY
DOMAIN-SUFFIX,twimg.com,PROXY
DOMAIN-SUFFIX,t.co,PROXY
DOMAIN-SUFFIX,twitpic.com,PROXY
DOMAIN-SUFFIX,periscope.tv,PROXY
