#!name=微博机型伪装
#!desc=修改发博请求 URL 里的 ua 机型标识，默认 iPhone 18 Pro Max
#!author=OliviaR13
#!homepage=https://github.com/OliviaR13/MyLoon
#!category=工具
#!system=iOS
#!arguments=MODEL:iPhone19.7,DEBUG:true
#!arguments-desc=MODEL：设备标识，逗号写成点号（iPhone19.7 即 iPhone19,7）\nDEBUG：true 时在日志输出修改结果

[Script]
http-request ^https?:\/\/api\.weibo\.cn\/2\/statuses\/(send|update|repost)\? script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/weibo_device.js, timeout=10, tag=微博机型伪装, argument=[{MODEL},{DEBUG}]

[MITM]
hostname = api.weibo.cn
