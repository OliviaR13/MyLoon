#!name = Outlook 登录修复
#!desc = 对 Microsoft / Outlook 认证相关域名直连，并跳过 MITM 解密，用于处理登录窗口反复弹出的问题。
#!tag = 登录修复
#!author = OliviaR13
#!version = 1.0.0
#!date = 2026-09-10
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Microsoft.png
#!homepage = https://www.github.com/OliviaR13

[Rule]
DOMAIN-SUFFIX,login.microsoftonline.com,DIRECT
DOMAIN-SUFFIX,login.live.com,DIRECT
DOMAIN-SUFFIX,login.windows.net,DIRECT
DOMAIN-SUFFIX,outlook.office365.com,DIRECT
DOMAIN-SUFFIX,outlook.office.com,DIRECT
DOMAIN-SUFFIX,outlook.com,DIRECT
DOMAIN-SUFFIX,graph.microsoft.com,DIRECT
DOMAIN-SUFFIX,officeapps.live.com,DIRECT
DOMAIN-SUFFIX,microsoftonline.com,DIRECT

[MITM]
skip-server-cert-verify = true
hostname = %APPEND% -login.microsoftonline.com, -login.live.com, -login.windows.net, -outlook.office365.com, -outlook.office.com, -outlook.com, -graph.microsoft.com, -officeapps.live.com, -microsoftonline.com
