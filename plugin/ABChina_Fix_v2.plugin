#!name=农业银行 App 服务异常修复
#!desc=针对中国农业银行 iOS App mobilepaas/mgw.htm 网络异常进行分流修复
#!author=ChatGPT
#!homepage=https://www.abchina.com.cn/

[Rule]
DOMAIN,mobilepaas.abchina.com.cn,DIRECT
DOMAIN,msmp.abchina.com.cn,DIRECT
DOMAIN,firefly.abchina.com.cn,DIRECT
DOMAIN,apm.abchina.com.cn,DIRECT
DOMAIN-SUFFIX,abchina.com.cn,DIRECT
DOMAIN-SUFFIX,abchina.com,DIRECT

# 禁止农行域名走 QUIC/HTTP3，避免部分网络环境下连接异常
AND,((DOMAIN-SUFFIX,abchina.com.cn),(PROTOCOL,QUIC)),REJECT-NO-DROP
AND,((DOMAIN-SUFFIX,abchina.com),(PROTOCOL,QUIC)),REJECT-NO-DROP

[MITM]
hostname = mobilepaas.abchina.com.cn,msmp.abchina.com.cn,firefly.abchina.com.cn,apm.abchina.com.cn
