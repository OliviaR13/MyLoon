#!name = Spotify 自选节点
#!desc = 为 Spotify 单独创建一个可自选节点的策略组，Spotify 流量将走此策略组，不再受全局策略组影响
#!author = Claude
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png

[Rule]
DOMAIN-SUFFIX,spotify.com,Spotify
DOMAIN-SUFFIX,spotifycdn.com,Spotify
DOMAIN-SUFFIX,scdn.co,Spotify
DOMAIN-SUFFIX,spoti.fi,Spotify
DOMAIN-SUFFIX,pscdn.co,Spotify
DOMAIN-SUFFIX,spotify.map.fastly.net,Spotify
DOMAIN-SUFFIX,audio-ak-spotify-com.akamaized.net,Spotify
DOMAIN-SUFFIX,audio4-ak-spotify-com.akamaized.net,Spotify
DOMAIN-SUFFIX,heads-ak-spotify-com.akamaized.net,Spotify
DOMAIN-SUFFIX,heads4-ak-spotify-com.akamaized.net,Spotify
DOMAIN-SUFFIX,spotify-static.akamaized.net,Spotify

[Policy]
Spotify = select,DIRECT,img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
