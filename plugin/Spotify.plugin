#!name = Spotify 自选节点
#!desc = 将 Spotify 相关域名（官方站点与 API、音频/图片 CDN、短链）统一走 PROXY 策略。安装后请在插件详情页的「代理指向的策略」中选择用于代理的策略组或节点，未选择时默认使用全局策略的第一个节点。请将本插件放在配置文件中 GEOIP,CN,DIRECT 等国内直连规则之前，否则规则可能被提前匹配而失效。
#!tag = 代理分流
#!author = OliviaR13
#!version = 1.0.0
#!date = 2026-09-20
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png

[Rule]
# 官方主站与 API
DOMAIN-SUFFIX,spotify.com,PROXY
DOMAIN-SUFFIX,byspotify.com,PROXY
DOMAIN-SUFFIX,spotify.design,PROXY
DOMAIN-SUFFIX,spotify.link,PROXY
DOMAIN-SUFFIX,spoti.fi,PROXY

# CDN（音频 / 图片 / 静态资源）
DOMAIN-SUFFIX,spotifycdn.com,PROXY
DOMAIN-SUFFIX,scdn.co,PROXY
DOMAIN-SUFFIX,pscdn.co,PROXY
DOMAIN-SUFFIX,spotify.map.fastly.net,PROXY

# 第三方 CDN（Akamai 历史节点，部分地区仍在使用）
DOMAIN-SUFFIX,audio-ak-spotify-com.akamaized.net,PROXY
DOMAIN-SUFFIX,audio4-ak-spotify-com.akamaized.net,PROXY
DOMAIN-SUFFIX,heads-ak-spotify-com.akamaized.net,PROXY
DOMAIN-SUFFIX,heads4-ak-spotify-com.akamaized.net,PROXY
DOMAIN-SUFFIX,spotify-static.akamaized.net,PROXY
