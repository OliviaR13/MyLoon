#!name = Siri AI Bridge
#!desc = 将 Siri 请求转换为通用 AI API 请求，支持 Gemini、OpenAI、Anthropic 及 OpenAI 兼容接口，并将响应转换为 Siri 可识别格式。当前仅支持文本输入；网络请求遵循 Loon 当前配置规则。
#!tag = AI,Siri,功能增强
#!system = iOS
#!loon_version = 3.2.4
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AI.png
#!date = 2026-11-07
#!version = 1.0.0

[Argument]
PROVIDER = input,"openai_compatible",tag=服务商,desc=gemini / openai / anthropic / openai_compatible
KEY = input,"",tag=API Key,desc=所选服务商的 API 密钥
BASE = input,"",tag=API 地址,desc=填写服务商 API 根地址；OpenAI 兼容接口可填写含 /v1 的地址
MODEL = input,"",tag=模型名称,desc=填写服务商支持的模型 ID
PROMPT = input,"你是 Siri 的后台助手。请用简洁、口语化的中文回答，适合直接朗读；不要使用 Markdown、列表符号或表情。",tag=系统提示词,desc=控制回答风格
SEARCH = switch,false,tag=联网搜索,desc=仅 Gemini 适配器支持 Google Search
MAX = input,"2048",tag=最大输出 Token,desc=最大生成长度（128–8192）

[Script]
http-request ^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses requires-body=true, timeout=60, script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/siri-ai/siri_ai_bridge.js, argument=[{PROVIDER},{KEY},{BASE},{MODEL},{PROMPT},{SEARCH},{MAX}], tag=Siri AI Bridge

[MitM]
hostname = prod-yabuli.qianwen.com
