#!name = 微博超话签到
#!desc = 抓取微博登录参数，每天定时给关注的超话签到（Loon 3.5.1 build 983+ 新语法）
#!author = 
#!icon = https://raw.githubusercontent.com/Loon0x00/LoonManual/main/docs/img/loon.png

[Argument]
cron = input,"10 8 * * *",tag=签到时间(Cron)
debug = switch,false,tag=调试日志

[Script]
# 抓参数：任意带 gsid 的微博 API 请求都行，不再依赖「我的-关注」页面
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\// && ${url} ~= /[?&]gsid=/ then script("https://raw.githubusercontent.com/OliviaR13/MyLoon/main/script/weibo_chaohua.js") with tag="微博超话-抓参数", timeout=10

# 定时签到
cron ${cron} then script("https://raw.githubusercontent.com/OliviaR13/MyLoon/main/script/weibo_chaohua.js", {${debug}}) with tag="微博超话签到", timeout=300

[MitM]
hostname = api.weibo.cn
