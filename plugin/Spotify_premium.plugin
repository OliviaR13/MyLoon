#!name = Spotify 会员解锁
#!desc = 解锁 Spotify Premium 会员。脚本原作者 @app2smile，本插件仅移植为 Loon 格式，脚本版权归原作者所有。使用前请在 Loon 中开启 MITM 并信任证书。
#!tag = 功能增强
#!author = @app2smile
#!homepage = https://github.com/app2smile/rules
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
#!date = 2026-10-07
#!version = 1.0.0

[Script]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/spotify/spotify-qx-header.js, timeout=60, tag=spotify-qx-header

http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/spotify/spotify-proto.js, requires-body=true, binary-body-mode=true, timeout=60, tag=spotify-proto

http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/ script-path=https://raw.githubusercontent.com/OliviaR13/MyLoon/refs/heads/main/script/spotify/spotify-json.js, timeout=60, tag=spotify-json

[MITM]
hostname = spclient.wg.spotify.com, *spclient.spotify.com
