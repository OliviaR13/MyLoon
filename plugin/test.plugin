#!name = 测试
#!desc = 测试
#!author = @OliviaR13
#!homepage = https://www.github.com/OliviaR13
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weibo.png
#!date = 2026-09-25
#!version = 1.9.7

[Argument]
policy.title = "代理策略"
policy.desc = "填入你自己策略组的名称，建议为固定单一节点（select 类型），不要用 url-test 自动测速类型，避免热启动冷建连超时被 App 取消请求。"
policy.type = input
policy.default = PROXY

strict.title = "严格匹配模式"
strict.desc = "开启后仅代理已明确验证的属地判定接口（api.weibo.cn/api.weibo.com），不再用 DOMAIN-KEYWORD 兜底匹配所有含 weibo 的域名，范围更小但可能漏掉个别未验证到的子域名。"
strict.type = switch
strict.default = 0

[Rule]
# === 1. 微博媒体 CDN 与 HTTPDNS —— 直连 ===
DOMAIN-SUFFIX, weibocdn.com, DIRECT
DOMAIN-SUFFIX, sinajs.cn, DIRECT
DOMAIN-SUFFIX, wbimg.cn, DIRECT
DOMAIN-SUFFIX, wbimg.com, DIRECT
DOMAIN, dns.weibo.cn, DIRECT
DOMAIN-SUFFIX, sinaimg.cn, DIRECT

# === 2. 微博属地判定与业务 API —— 代理 ===
DOMAIN-SUFFIX, weibo.cn, {{{policy}}}
DOMAIN-SUFFIX, weibo.com, {{{policy}}}
DOMAIN-KEYWORD, weibo, {{{policy}}}
